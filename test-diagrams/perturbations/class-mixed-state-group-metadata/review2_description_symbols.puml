@startuml
allowmixing
actor "Release Operator" as ReleaseOperator
usecase "Approve Rollout" as ApproveRollout
component "Policy Engine" as PolicyEngine
circle ReleaseJunction
diamond ReleaseChoice
state ReleasePending
object ReleaseTrace
class ReleaseRecord
ReleaseOperator --> ApproveRollout
