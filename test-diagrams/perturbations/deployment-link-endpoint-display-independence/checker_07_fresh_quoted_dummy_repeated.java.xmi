                    </UML:Association.connection>
                </UML:Association>
                <UML:Association name="reuse as source" namespace="model1" xmi.id="ass11">
                    <UML:Association.connection>
                        <UML:AssociationEnd association="ass11" type="ent0004" xmi.id="end12">
