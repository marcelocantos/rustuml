@startuml
state ObservatoryHull {
  [*] --> LensAssembly
  state LensAssembly {
    [*] --> IndigoLens
    IndigoLens --> VermilionLens : focus
    VermilionLens --> IndigoLens : defocus
    VermilionLens --> [*]
  }
  LensAssembly --> CalibrationDeck : inspect
  CalibrationDeck --> LensAssembly : repeat
  CalibrationDeck --> [*]
}
[*] --> ObservatoryHull
ObservatoryHull --> [*]
@enduml
