[
  {
    "name": "oracle-final",
    "command": [
      "cargo",
      "test",
      "-p",
      "rustuml-oracle",
      "--release",
      "--test",
      "golden_no_oracle",
      "--test",
      "golden_pairs",
      "--test",
      "parity_perturbations",
      "--test",
      "harness_guards",
      "--no-fail-fast",
      "--",
      "--nocapture"
    ],
    "exit": 101
  },
  {
    "name": "cli-final",
    "command": [
      "cargo",
      "test",
      "-p",
      "rustuml",
      "--test",
      "pipe_mode"
    ],
    "exit": 0
  },
  {
    "name": "parser-final",
    "command": [
      "cargo",
      "test",
      "-p",
      "rustuml-parser",
      "--lib"
    ],
    "exit": 0
  },
  {
    "name": "clippy-final",
    "command": [
      "cargo",
      "clippy",
      "-p",
      "rustuml-parser",
      "--",
      "-D",
      "warnings"
    ],
    "exit": 101
  },
  {
    "name": "format-final",
    "command": [
      "rustfmt",
      "--edition",
      "2024",
      "--check",
      "crates/rustuml-parser/src/preprocess/mod.rs"
    ],
    "exit": 0
  },
  {
    "name": "diff-final",
    "command": [
      "git",
      "diff",
      "--check"
    ],
    "exit": 0
  }
]
