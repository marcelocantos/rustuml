    {
      "implementation": "df9078e2e162752328ffa52ebb28f227e56bc8f6",
      "account_is_ancestor": true,
      "message": "fix: share exact Pattern2 whitespace across sequence regexes\n\nPreimplementation account 0b512262a (sequence-pattern2-whitespace). Use ASCII whitespace plus NBSP, including negation; preserve Unicode non-whitespace grammar and explicit rejection-contract evidence.\n\n"
    },
    {
      "implementation": "f4b3db075f61e2a5444777a305ab9bb64fd3685d",
      "account_is_ancestor": true,
      "message": "fix: share ordered Display across every sequence participant component\n\nPreimplementation account 0b512262a: sequence-all-participant-display-consumers. Remove boxed-only stereotype suppression; reuse one ordered Display painter and complete text height for heads, tails and created figures. Preserve component-specific margins and symbol geometry.\n\n"
    },
    {
      "implementation": "47fb7bd3a27d62ed80cdca112721be7ca61fc2e6",
      "account_is_ancestor": true,
      "message": "fix: select the folded Teoz self-note component before layout\n\nPreimplementation account 0b512262a: sequence-teoz-self-note-component. Follow CommunicationTileSelfNoteLeft/Right for measure and paint after return lowering, without mutating the parsed Note shape.\n\n"
    },
    {
      "implementation": "d491d4bda47faf90d4751484d45aa1387fb1b290",
      "account_is_ancestor": true,
      "message": "fix: reject bare sequence note-over commands\n\nPreimplementation account 0b512262a: sequence-note-over-command-domain. Arrow note grammar permits left/right only; over requires a named participant. Preserve across and explicit over commands.\n\n"
    }
  ],
