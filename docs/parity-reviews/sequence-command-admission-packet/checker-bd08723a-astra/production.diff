 fn escape_xml(s: &str) -> String {
+    let mut escaped = String::with_capacity(s.len());
+    for ch in s.chars() {
+        match ch {
+            '&' => escaped.push_str("&amp;"),
+            '<' => escaped.push_str("&lt;"),
+            '>' => escaped.push_str("&gt;"),
+            '"' => escaped.push_str("&quot;"),
+            '\n' | '\r' | '\t' => write!(escaped, "&#{};", u32::from(ch)).unwrap(),
+            ch if !ch.is_ascii() => write!(escaped, "&#{};", u32::from(ch)).unwrap(),
+            ch => escaped.push(ch),
+        }
+    }
+    escaped
