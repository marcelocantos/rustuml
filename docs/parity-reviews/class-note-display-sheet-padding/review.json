  "source_model_review": {
    "java_findings": [
      "Display.getCreole creates a Sheet from the complete Display, reads spriteContainer.getPadding(), then wraps the whole sheet in SheetBlock1 before SheetBlock2.",
      "SheetBlock1.calculateDimensionSlow expands dimensions by top plus bottom and left plus right padding, and drawU translates the complete wrapped content by left/top padding.",
      "AbstractTextualComponent composes the Display-created text block separately from Rose note margins.",
      "EntityImageNoteLink constructs the same Rose note component for relationship-owned notes."
    ],
    "rust_findings": [
      "ResolvedNoteStyle carries one parsed global skinparam Padding value for standalone, attached, and relationship-owned Class notes.",
      "note_box_dims and relationship_note_box_dims add 2 * sheet_padding to the complete body dimensions.",
      "emit_note_body translates the complete note body by sheet_padding on x and y and reduces the available body width by 2 * sheet_padding.",
      "No label, source-line, fixture-name, note-position, or branch-count conditional was found in the implementation hunk."
    ]
  },
