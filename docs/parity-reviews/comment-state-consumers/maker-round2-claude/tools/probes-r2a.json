 {
  "name": "intval_arabic_indic_signed",
  "intended_valid": true,
  "axes": [
   "Arabic-Indic digits",
   "leading minus and plus"
  ],
  "source": [
   "@startuml",
   "!$a = %intval(\"-٣٢١\")",
   "!$b = %intval(\"+٧\")",
   "class \"$a / $b\" as Signed",
   "@enduml"
  ]
 },
 {
  "name": "intval_extended_arabic_bengali",
  "intended_valid": true,
  "axes": [
   "extended Arabic-Indic",
   "Bengali",
   "Thai",
   "mixed scripts"
  ],
  "source": [
   "@startuml",
   "!$a = %intval(\"۴۵\")",
   "!$b = %intval(\"১๒3\")",
   "class \"$a and $b\" as Mixed",
   "@enduml"
  ]
 },
 {
  "name": "intval_fullwidth_bounds",
  "intended_valid": true,
  "axes": [
   "fullwidth digits",
   "Integer.MAX_VALUE and MIN_VALUE"
  ],
  "source": [
   "@startuml",
   "!$a = %intval(\"２１４７４８３６４７\")",
   "!$b = %intval(\"-２１４７４８３６４８\")",
   "class \"$a $b\" as Bounds",
   "@enduml"
  ]
 },
 {
  "name": "intval_myanmar_tai_laing",
