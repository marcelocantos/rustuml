@startuml



skinparam backgroundColor #721345
skinparam useBetaStyle false






<style>
  root {
    BackgroundColor #721345
    FontColor #2A9FD6
    HyperLinkColor #fd7e14
    LineColor #55B2DE
    LineThickness 1
    Margin 10
    Padding 6
    Shadowing 0.0
  }
  node {
   Padding 15
   roundcorner 20
   BackgroundColor #721345
  }
  caption {
    LineThickness 0
  }
  footer {
    LineThickness 0
  }
  groupHeader {
    BackgroundColor #555
    FontColor #9933CC
    FontStyle bold
  }
  header {
    LineThickness 0
  }
  referenceHeader {
    BackgroundColor #721345
    FontColor #ADAFAE
    FontStyle bold
  }
  separator {
    BackgroundColor #FFF
    FontColor #721345
    FontStyle bold
  }
  title {
	FontSize 20
	BorderRoundCorner            8
	BorderThickness 	         1
	BackgroundColor  #721345
	FontColor #2A9FD6
	BorderColor #555
  }
  nwdiagDiagram {
	network {
			FontColor #2A9FD6
	BorderColor #55B2DE
	BackgroundColor #721345    
		LineColor #2A9FD6
		LineThickness 1.0
		FontColor #227FAB
	}
	server {
			FontColor #2A9FD6
	BorderColor #55B2DE
	BackgroundColor #721345
	}
	arrow {
		FontColor #227FAB
		LineColor #227FAB
	}
	group {
		BackGroundColor #222
		LineColor #4E4E4E
		LineThickness 2.0
		Margin 5
		Padding 5
	}
  }
  ganttDiagram {
	task {
			FontColor #2A9FD6
	BorderColor #55B2DE
	BackgroundColor #721345
		LineColor #2A9FD6
		Margin 10 2 2 2
		Padding 6
	}
	note {
		FontColor #9933CC
		LineColor #AD5CD6
		BackGroundColor #721345
	}
	separator {
		LineColor #777777
		BackGroundColor #721345
		FontColor #777777
	}
	milestone {
		FontColor #9933CC
		FontSize 16
		FontStyle italic
		BackGroundColor #555
		LineColor #777777
	}
	timeline {
		BackgroundColor #555
		FontColor #777777
	}
	closed {
		BackgroundColor #FFA033
		FontColor #FF8800
	}
  }
</style>
skinparam defaultFontName       "Verdana"
skinparam defaultFontSize       12
skinparam dpi                   100
skinparam shadowing             false
skinparam roundcorner           8
skinparam ParticipantPadding    40
skinparam BoxPadding            40
skinparam Padding               5
skinparam ArrowColor            #ADAFAE
skinparam stereotype {
    CBackgroundColor #777777
    CBorderColor #444444
    ABackgroundColor #5F8F00
    ABorderColor #92C233
    IBackgroundColor #a30000
    IBorderColor #D63333
    EBackgroundColor #cc6d00
    EBorderColor #FFA033
    NBackgroundColor #7a29a3
    NBorderColor #AD5CD6
}
skinparam title {
	FontColor	                 #2A9FD6
	BorderColor	                 #777777
	FontSize	    	         20
	BorderRoundCorner            8
	BorderThickness 	         1
	BackgroundColor              #721345
}

skinparam legend {
	BackgroundColor #721345
	BorderColor #777777
	FontColor #ADAFAE
}

skinparam swimlane {
	BorderColor #9933CC
	BorderThickness 2
	TitleBackgroundColor  #444444-#555
	TitleFontColor #2A9FD6
}


skinparam activity {
		FontColor #2A9FD6
	BorderColor #55B2DE
	BackgroundColor #721345
	BarColor #77B300
	StartColor #9933CC
	EndColor #9933CC
	DiamondBackgroundColor #721345
  	DiamondBorderColor #777777
  	DiamondFontColor #777777
}


skinparam participant {
		FontColor #2A9FD6
	BorderColor #55B2DE
	BackgroundColor #721345
	ParticipantBorderThickness 2
}


skinparam actor {
		FontColor #2A9FD6
	BorderColor #55B2DE
	BackgroundColor #721345
	FontColor #2A9FD6
}


skinparam arrow {
	Thickness 3
	Color #2A9FD6
	FontColor #FFF
}


skinparam sequence {
	BorderColor #2A9FD6
	TitleFontColor #2A9FD6
	BackgroundColor #721345
	StartColor #2A9FD6
	EndColor #2A9FD6
	BoxBackgroundColor #721345
	BoxBorderColor #ADAFAE
	BoxFontColor #ADAFAE
	DelayFontColor #ADAFAE
	LifeLineBorderColor #555
	LifeLineBorderThickness 2
	LifeLineBackgroundColor #721345
	GroupBorderColor #ADAFAE
	GroupFontColor #ADAFAE
	GroupHeaderFontColor #9933CC
	GroupBackgroundColor #721345
	GroupHeaderBackgroundColor #721345
	DividerBackgroundColor #721345
    DividerBorderColor #ADAFAE
    DividerBorderThickness 2
    DividerFontColor #ADAFAE
	ReferenceBackgroundColor #721345
	ReferenceBorderColor #ADAFAE
	ReferenceFontColor #ADAFAE
	ReferenceHeaderFontColor #9933CC
	ReferenceHeaderBackgroundColor #721345
	StereotypeFontColor #2A9FD6
}


skinparam partition {
	BorderColor #2A9FD6
	FontColor #2A9FD6
	BackgroundColor #721345
}


skinparam collections {
		FontColor #2A9FD6
	BorderColor #55B2DE
	BackgroundColor #721345
}


skinparam control {
		FontColor #2A9FD6
	BorderColor #55B2DE
	BackgroundColor #721345
	FontColor #2A9FD6
}


skinparam entity {
		FontColor #2A9FD6
	BorderColor #55B2DE
	BackgroundColor #721345
	FontColor #2A9FD6
}


skinparam boundary {
		FontColor #2A9FD6
	BorderColor #55B2DE
	BackgroundColor #721345
	FontColor #2A9FD6
}


skinparam agent {
	BackgroundColor #721345
	BorderColor #cc6d00
	FontColor #ADAFAE
}


skinparam note {
	BorderThickness 1
	BackgroundColor #721345
	BorderColor #AD5CD6
	FontColor #AD5CD6
}


skinparam artifact {
	BackgroundColor #721345
	BorderColor #BDBFBE
	FontColor #BDBFBE
}


skinparam component {
		FontColor #2A9FD6
	BorderColor #55B2DE
	BackgroundColor #721345
}


skinparam interface {
	BackgroundColor  #721345
	BorderColor  #CC0000
	FontColor #ADAFAE
}


skinparam storage {
	BackgroundColor #721345
  	BorderColor #FFA033
	FontColor #FF8800
}


skinparam node {
	BackgroundColor  #721345
	BorderColor #ADAFAE
	FontColor #ADAFAE
}


skinparam cloud {
	BackgroundColor #721345
	BorderColor #F2FCFE
	FontColor #ADAFAE
}


skinparam database {
		FontColor #2A9FD6
	BorderColor #55B2DE
	BackgroundColor #721345
	FontColor #2A9FD6
}



skinparam class {
		FontColor #2A9FD6
	BorderColor #55B2DE
	BackgroundColor #721345
        FontColor #222
	HeaderBackgroundColor #227FAB
	StereotypeFontColor #ADAFAE
	BorderThickness 1
	AttributeFontColor #ADAFAE
	AttributeFontSize 11
}


skinparam object {
		FontColor #2A9FD6
	BorderColor #55B2DE
	BackgroundColor #721345
	StereotypeFontColor #ADAFAE
	BorderThickness 1
	AttributeFontColor #777777
	AttributeFontSize 11
}


skinparam usecase {
		FontColor #2A9FD6
	BorderColor #55B2DE
	BackgroundColor #721345
	BorderThickness 2
	StereotypeFontColor #2A9FD6
}


skinparam rectangle {
		FontColor #2A9FD6
	BorderColor #55B2DE
	BackgroundColor #721345
	BorderThickness 2
	StereotypeFontColor #2A9FD6
}


skinparam package {
	BackgroundColor #721345
  	BorderColor #2A9FD6
	FontColor #2A9FD6
	BorderThickness 2
}


skinparam folder {
	BackgroundColor #721345
  	BorderColor #FF8800
	FontColor #FF8800
	BorderThickness 2
}


skinparam frame {
	BackgroundColor #721345
  	BorderColor #9933CC
	FontColor #9933CC
	BorderThickness 2
}


skinparam state {
		FontColor #2A9FD6
	BorderColor #55B2DE
	BackgroundColor #721345
	StartColor #9933CC
	EndColor #9933CC
	AttributeFontColor #777777
	AttributeFontSize 11
}


skinparam queue {
		FontColor #2A9FD6
	BorderColor #55B2DE
	BackgroundColor #721345
}


skinparam card {
	BackgroundColor #721345
	BorderColor #9933CC
	FontColor #9933CC
}


skinparam file {
	BackgroundColor #721345
	BorderColor #555
	FontColor #555
}


skinparam stack {
		FontColor #2A9FD6
	BorderColor #55B2DE
	BackgroundColor #721345
}
class GarnetRegistry
@enduml
