  "findings": [
    {
      "severity": "rejecting",
      "title": "The shared color suffix over-accepts tokens Java rejects",
      "java_mechanism": "CommandFactoryNote delegates the final slot to ColorParser.exp1(), whose COLOR_REGEXP/COLORS_REGEXP grammar is narrower than an arbitrary non-whitespace suffix; execution also resolves the captured value and returns No such color on failure.",
      "rust_mechanism": "parse::named_note_decorations at parse/mod.rs:47-71 accepts #[^\\s]+ without Java color grammar or resolution.",
      "evidence": [
        "checker_component_invalid_single_char_color.puml",
        "checker_deployment_invalid_single_char_color.puml",
        "checker_component_composite_color.puml",
        "checker_deployment_composite_color.puml"
      ],
      "impact": "Both families create a named note and relation for #R, and silently render a Java No such color case. This is a parser recognition and product-semantics mismatch."
    },
    {
      "severity": "rejecting",
      "title": "Component cannot reuse named-note codes admitted by the shared grammar",
      "java_mechanism": "CommandFactoryNote creates the note quark from its dotted/Unicode CODE; CommandLinkElement cleanId/quarkInContext resolves a later relation endpoint back to that entity.",
      "rust_mechanism": "parse/component.rs:45-49 restricts RE_DESCRIPTION_CONN bare endpoints to \\w+, while parse/mod.rs:36 and parse/component.rs:710-800 admit dots and Unicode in a named note. The relation does not match and is omitted from the AST.",
      "evidence": [
        "checker_component_inline_matrix.puml",
        "checker_component_multiline_nested_endnote.puml",
        "checker_component_unicode_multiline_end_space_note.puml",
        "checker_component_preprocessed_order.puml",
        "checker_component_simple_relation_reuse.puml"
      ],
      "impact": "The simple control succeeds, but every dotted valid Component relation is lost despite the named note being present. This violates the account's relation-reuse invariant; it is distinct from Java's declared Unicode-to-dot SVG metadata normalization."
    },
    {
      "severity": "rejecting",
      "title": "Deployment invalid-note rejection falls through into synthetic endpoint creation",
      "java_mechanism": "A malformed CommandFactoryNote command rejects the diagram rather than creating a quark or relation endpoint.",
      "rust_mechanism": "When the shared note parser returns None, parse/deployment.rs proceeds to its ordinary relation parser, which materializes Bad_Deployment from the later relation line.",
      "evidence": [
        "checker_deployment_invalid_reordered.puml",
        "checker_deployment_invalid_punctuation.puml"
      ],
      "impact": "Malformed note syntax changes entity inventory and UID/source ordering instead of rejecting. The account expressly forbids invalid punctuation or reordered decorations from creating identities."
    }
  ],
