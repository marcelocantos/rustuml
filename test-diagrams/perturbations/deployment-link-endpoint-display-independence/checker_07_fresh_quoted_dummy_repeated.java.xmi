                        <UML:AssociationEnd association="ass11" type="ent0003" xmi.id="end13">
                            <UML:AssociationEnd.participant/>
                        </UML:AssociationEnd>
                    </UML:Association.connection>
                </UML:Association>
                <UML:Association name="reuse as target" namespace="model1" xmi.id="ass14">
                    <UML:Association.connection>
                        <UML:AssociationEnd association="ass14" type="ent0003" xmi.id="end15">
                            <UML:AssociationEnd.participant/>
