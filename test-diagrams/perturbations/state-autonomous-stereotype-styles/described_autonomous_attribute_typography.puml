@startuml
skinparam state {
  FontName<<ledger>> Courier New
  FontSize<<ledger>> 19
  FontStyle<<ledger>> bold
  AttributeFontName<<ledger>> Courier New
  AttributeFontSize<<ledger>> 16
  AttributeFontStyle<<ledger>> italic
  FontName<<signal>> Serif
  FontSize<<signal>> 17
  FontStyle<<signal>> 700
  AttributeFontName<<signal>> SansSerif
  AttributeFontSize<<signal>> 13
  AttributeFontStyle<<signal>> normal
}
state "Typography Vault" as TypographyVault <<ledger>> {
  [*] --> LedgerLeaf
  state "Ledger Leaf" as LedgerLeaf <<ledger>>
  LedgerLeaf : alpha register
  LedgerLeaf : beta register
  state "Signal Leaf" as SignalLeaf <<signal>>
  SignalLeaf : gamma record
  LedgerLeaf --> SignalLeaf
  SignalLeaf --> [*]
}
[*] --> TypographyVault
TypographyVault --> [*]
@enduml
