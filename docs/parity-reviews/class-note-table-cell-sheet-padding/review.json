  "source_model_review": {
    "java_findings": [
      "StripeTable.asAtom wraps every parsed cell in a SheetBlock1 using skinParam.getPadding().",
      "StripeTable.analyzeAndAddInternal splits rows into cells and calls table.addCell(asAtom(cells, skinParam.getPadding()), cellBackColor).",
      "SheetBlock1 expands each cell by padding on both axes and translates the cell content by left/top padding.",
      "AtomTable measures the wrapped cell dimensions, takes maximum width per column and maximum height per row, and draws each cell at its track origin.",
      "Display.getCreole adds a separate outer SheetBlock1 around the complete note sheet."
    ],
    "rust_findings": [
      "note_table_layout adds 2 * sheet_padding to each measured cell width and height before column and row maxima are computed.",
      "emit_note_table paints cell text at cell_left + sheet_padding and row_top + sheet_padding + row_ascent.",
      "note_box_dims, relationship_note_box_dims, and emit_note_body apply the separate outer Display padding after the table-cell layout layer.",
      "No label, source-line, fixture-name, row-count, column-count, or coordinate-specific branch was found in the implementation hunk."
    ]
  },
