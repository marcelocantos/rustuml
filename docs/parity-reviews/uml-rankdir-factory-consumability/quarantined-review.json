  "findings": [
    {
      "severity": "rejecting",
      "title": "Valid case-insensitive rankdir commands leave Sequence viable in Rust",
      "java_mechanism": "CommandRankDir is compiled through Pattern2.compileInternal with Pattern.CASE_INSENSITIVE. PSystemCommandFactory therefore consumes mixed-case rankdir in Class and Description but SequenceDiagramFactory cannot consume it, so PSystemBuilder proceeds to a later viable factory.",
      "rust_mechanism": "detect_uml_subtype sets has_direction_directive only for two exact lowercase strings. The later class parser is case-insensitive, but that is too late when weak arrows or shared database/queue declarations give Sequence the winning score.",
      "evidence": ["checker_39", "checker_42", "checker_43"],
      "impact": "All three inputs are valid in Java and Rust, but Java emits graph entity/link groups while the shipped no-oracle Rust path emits participant lifelines and message groups. This directly violates the claimed factory-viability invariant."
    },
    {
      "severity": "rejecting",
      "title": "Valid rankdir separator whitespace is narrower in Rust than Java",
      "java_mechanism": "CommandRankDir uses RegexLeaf.spaceOneOrMore before the final direction keyword, so `left to right    direction` is valid and eliminates Sequence.",
      "rust_mechanism": "The exact-string has_direction_directive test does not normalize runs of spaces. Rust leaves Sequence eligible and the weak arrow selects it.",
      "evidence": ["checker_44"],
      "impact": "A fresh valid whitespace perturbation dispatches CLASS in Java and SEQUENCE in Rust."
    },
    {
      "severity": "rejecting",
      "title": "The manually enumerated Sequence-only inventory omits registered commands",
      "java_mechanism": "SequenceDiagramFactory registers CommandGrouping, CommandActivate2, CommandAutoNewpage, CommandDivider, CommandDelay, create/destroy lifecycle handling and labeled CommandNewpage forms. When rankdir eliminates Sequence, Class/Description candidates reject these unrecognized forms unless their own command grammar explicitly consumes the exact variant.",
      "rust_mechanism": "looks_like_sequence_only_factory_command lists selected word prefixes but omits grouping, divider, delay, autonewpage, short ++/-- activation, create/destroy and labeled newpage. detect_uml_subtype then falls through to Class or Component; those parsers explicitly ignore unknown lines, and truncate_at_newpage accepts labeled newpage globally.",
      "evidence": ["checker_20", "checker_21", "checker_24", "checker_25", "checker_33", "checker_34", "checker_35", "checker_36"],
      "impact": "Java rejects each mixed grammar while the shipped Rust binary exits zero and emits graph SVG, violating the account acceptance requirement that no later permissive parser silently discard a Sequence-only command."
    },
    {
      "severity": "rejecting",
      "title": "The account's shared-newpage category collapses two different Java grammars",
