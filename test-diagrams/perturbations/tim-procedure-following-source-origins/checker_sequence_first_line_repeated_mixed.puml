@startuml
!procedure $ping($from, $to)
$from -> $to : ping
!endprocedure
!procedure $roundtrip($from, $to, $label)
$from -> $to : $label
$to --> $from : reply
!endprocedure
$ping(OrchidUI, SlateAPI)
$roundtrip(SlateAPI, HarborDB, "lookup")
$ping(HarborDB, OrchidUI)

