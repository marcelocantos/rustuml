+            let (text_width, _, stereo_height) =
+                description_text_size(entity, effective_hide(diagram, entity), style);
+            return (
+                ((position.width - text_width) / 2.0).min((position.width - 49.0) / 2.0 + 4.0),
+                if stereo_height > 0.0 { 0.0 } else { 4.0 },
